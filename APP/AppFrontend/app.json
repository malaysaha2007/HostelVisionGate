{
  "expo": {
    "name": "Hostel VisionGate App",
    "slug": "main-gate-entry-exit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maingateentryexitapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "permissions": [
  "android.permission.CAMERA"
],

      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.malay07.maingateentryexitapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
"plugins": [
  "expo-router",

  "expo-dev-client",

  

  [
    "expo-splash-screen",
    {
      "image": "./assets/images/splash-icon.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "backgroundColor": "#000000"
      }
    }
  ],

  "expo-web-browser",

  [
    "expo-location",
    {
      "locationAlwaysAndWhenInUsePermission": "Allow HostelVisionGate to use your location to detect when you enter or leave the hostel area."
    }
  ],

  "expo-font"
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85c32ad7-a9e0-4025-bc2b-b0f4c4e5f0c2"
      }
    }
  }
}
